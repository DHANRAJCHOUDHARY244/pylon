# =============================================================================
# Pylon — comprehensive .gitignore (monorepo: frontend + backend + docs)
# =============================================================================

# -----------------------------------------------------------------------------
# Dependencies
# -----------------------------------------------------------------------------
node_modules/
**/node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions
.pnpm-store/
**/.pnpm-store/
bower_components/
jspm_packages/
web_modules/

# -----------------------------------------------------------------------------
# Environment & secrets (keep *.example committed)
# -----------------------------------------------------------------------------
.env
.env.*
!.env.example
!**/.env.example
.env.local
.env.development.local
.env.test.local
.env.production.local
*.pem
*.p12
*.key
*.crt
*.cer
*.pfx
secrets/
**/secrets/
credentials.json
**/credentials.json
service-account*.json
**/service-account*.json
*.secret
*.secrets

# -----------------------------------------------------------------------------
# Next.js (frontend)
# -----------------------------------------------------------------------------
.next/
**/.next/
out/
**/out/
.vercel/
**/.vercel/
next-env.d.ts
**/next-env.d.ts

# -----------------------------------------------------------------------------
# Build / compile outputs
# -----------------------------------------------------------------------------
dist/
**/dist/
build/
**/build/
lib/
!**/src/lib/
es/
esm/
cjs/
coverage/
**/coverage/
*.tsbuildinfo
**/*.tsbuildinfo
*.map
!**/src/**/*.map

# -----------------------------------------------------------------------------
# Logs & debug
# -----------------------------------------------------------------------------
logs/
**/logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
*.pid
*.seed
*.pid.lock
report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json

# -----------------------------------------------------------------------------
# Test / cache
# -----------------------------------------------------------------------------
.cache/
**/.cache/
.parcel-cache/
.turbo/
**/.turbo/
.eslintcache
**/.eslintcache
.stylelintcache
.rpt2_cache/
.rts2_cache_cjs/
.rts2_cache_es/
.rts2_cache_umd/
.npm/
.yarn-integrity
.node_repl_history
.vitest/
**/__screenshots__/
playwright-report/
test-results/
**/test-results/
.nyc_output/
**/nyc_output/

# -----------------------------------------------------------------------------
# OS junk
# -----------------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini
$RECYCLE.BIN/
*.lnk
*.swp
*.swo
*~

# -----------------------------------------------------------------------------
# Editors / IDEs
# -----------------------------------------------------------------------------
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
.idea/
**/.idea/
*.sublime-project
*.sublime-workspace
*.code-workspace
.project
.classpath
.c9/
*.launch
.settings/
*.tmproj
*.esproj
.history/
.ionide/

# -----------------------------------------------------------------------------
# Reference extracts / reverse dumps / local scratch
# -----------------------------------------------------------------------------
_ref/
**/_ref/
_ref_extract/
**/_ref_extract/
.tmp/
**/.tmp/
tmp/
!**/src/**/tmp/
temp/
*.bak
*.tmp
*.temp
*.orig
*.rej

# -----------------------------------------------------------------------------
# Uploads / local media / generated assets
# -----------------------------------------------------------------------------
uploads/
**/uploads/
public/uploads/
**/public/uploads/
*.local.json
!**/fixtures/**/*.json

# -----------------------------------------------------------------------------
# Database / local data dumps
# -----------------------------------------------------------------------------
*.sqlite
*.sqlite3
*.db
dump.rdb
*.mongo
data/
!**/src/**/data/
!**/docs/**/data/

# -----------------------------------------------------------------------------
# Docker / infra local overrides
# -----------------------------------------------------------------------------
docker-compose.override.yml
.docker/
**/.docker/

# -----------------------------------------------------------------------------
# Misc tooling
# -----------------------------------------------------------------------------
.claude/
.cursor/
!.cursor/rules/
!.cursor/commands/
agent-tools/
agent-transcripts/
*.canvas.tsx.bak

# -----------------------------------------------------------------------------
# Package manager locks (optional — uncomment if you want to ignore locks)
# -----------------------------------------------------------------------------
# package-lock.json
# yarn.lock
# pnpm-lock.yaml

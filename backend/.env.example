NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/pylon
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d
CORS_ORIGIN=http://localhost:3000,http://localhost:3006
FRONTEND_URL=http://localhost:3000
REDIS_URL=redis://127.0.0.1:6379
LOG_LEVEL=info

# Google Calendar — create OAuth client at https://console.cloud.google.com/
# Enable Google Calendar API; redirect URI must match exactly.
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
GOOGLE_CALENDAR_REDIRECT_URI=http://localhost:5000/api/v1/crm/calendar/oauth/google/callback

# Outlook / Microsoft 365 — register app at https://portal.azure.com/ (App registrations)
# API permissions: Calendars.ReadWrite, User.Read, offline_access
MICROSOFT_CALENDAR_CLIENT_ID=
MICROSOFT_CALENDAR_CLIENT_SECRET=
MICROSOFT_CALENDAR_REDIRECT_URI=http://localhost:5000/api/v1/crm/calendar/oauth/outlook/callback
